#!/bin/sh /etc/rc.common
# One instance per configuration file, because one process serves one modem.

USE_PROCD=1
START=95
STOP=10

CONFIG_DIR=/etc/modem2sip
BIN=/usr/bin/modem2sip

start_instance() {
	local cfg="$1"
	local name

	name="$(basename "$cfg" .toml)"

	# The database and MMS attachments live wherever storage.dir points;
	# create it so a fresh install works without manual steps.
	local dir
	dir="$(sed -n 's/^[[:space:]]*dir[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" | head -1)"
	[ -n "$dir" ] && mkdir -p "$dir"

	procd_open_instance "$name"
	procd_set_param command "$BIN" --config "$cfg"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile "/var/run/modem2sip.$name.pid"
	# Restart the instance when its configuration changes.
	procd_set_param file "$cfg"
	procd_close_instance
}

start_service() {
	local found=0
	local cfg

	for cfg in "$CONFIG_DIR"/*.toml; do
		[ -f "$cfg" ] || continue
		start_instance "$cfg"
		found=1
	done

	[ "$found" = 1 ] || echo "modem2sip: no configuration in $CONFIG_DIR/*.toml" >&2
}

service_triggers() {
	# ModemManager owns the modem; if it restarts, our instances reconnect
	# on their own, so only the configuration needs watching.
	procd_add_config_trigger "config.change" "modem2sip" /etc/init.d/modem2sip reload
}

reload_service() {
	stop
	start
}
